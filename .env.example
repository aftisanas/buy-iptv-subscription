# "hub"      -> plan cards route to /checkout (email capture -> Shopify -> WhatsApp fallback)
# "whatsapp" -> plan cards open the order modal and go straight to wa.me
# Defaults to "whatsapp" so a fresh deploy can never strand buyers in a
# checkout whose store has not been provisioned yet.
NEXT_PUBLIC_CHECKOUT_MODE=whatsapp

#NEXT_PUBLIC_CHECKOUT_HUB_URL=https://checkout.british-iptv-4k.com
